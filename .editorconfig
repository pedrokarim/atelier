root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# PowerShell 5.1 et Inno Setup lisent mal l'UTF-8 sans BOM.
[*.{ps1,iss}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
